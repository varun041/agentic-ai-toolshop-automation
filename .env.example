# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual tokens.

# GitHub MCP server (github.com/modelcontextprotocol/server-github)
# Personal access token with repo scope
GITHUB_PERSONAL_ACCESS_TOKEN=

# Jira MCP server (@bodywave/jira-mcp)
JIRA_URL=https://your-site.atlassian.net/
JIRA_EMAIL=you@example.com
JIRA_API_KEY=

# Playwright MCP server (@dinesh-nalla-se/playwright-mcp)
PLAYWRIGHT_API_KEY=

# Toolshop test target — override to point the suite at a different
# environment (local/staging) without touching test code or feature files.
# Both default to the live demo site if left unset.
BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com
