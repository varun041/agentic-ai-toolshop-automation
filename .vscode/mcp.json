{
  "servers": {
    "playwright-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dinesh-nalla-se/playwright-mcp"
      ],
      "env": {
        "YOUR_API_KEY": "${env:PLAYWRIGHT_API_KEY}"
      }
    },
   "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
   "jira": {
      "command": "npx",
      "args": [
        "-y",
        "@bodywave/jira-mcp"
      ],
      "env": {
        "JIRA_URL": "${env:JIRA_URL}",
        "JIRA_EMAIL": "${env:JIRA_EMAIL}",
        "JIRA_API_KEY": "${env:JIRA_API_KEY}"
      }
    }
    
  }
}
