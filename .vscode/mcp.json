{
  "servers": {
    "playwright-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dinesh-nalla-se/playwright-mcp"
      ],
      "env": {
        "YOUR_API_KEY": ""
      }
    },
   "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
   "jira": {
      "command": "npx",
      "args": [
        "-y",
        "@bodywave/jira-mcp"
      ],
      "env": {
        "JIRA_URL": "https://varunoberoi13-1785218517878.atlassian.net/",
        "JIRA_EMAIL": "varun.oberoi13@gmail.com",
        "JIRA_API_KEY": "${env:JIRA_API_KEY}"
      }
    }
    
  }
}
